# Synthetic prototype only. Copy to .env for npm start.
DATABASE_URL=file:accelera.db
DATABASE_AUTH_TOKEN=
STAFF_USERNAME=analyst
# Use bcryptjs to generate a hash of a strong staff password.
STAFF_PASSWORD_HASH=
# Supply random secrets: session 32+ characters; case derivation key 32+ characters.
SESSION_SECRET=
CASE_TOKEN_SECRET=
PORT=4174
# Optional wording assistance. Leave blank for guided policy responses.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Set only for a verified trusted ingress; leave 0 for direct/local access.
TRUST_PROXY_HOPS=0
